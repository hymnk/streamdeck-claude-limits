{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Claude Limits",
  "Author": "hymnk",
  "URL": "https://github.com/hymnk/streamdeck-claude-limits",
  "Description": "Shows your Claude session (5-hour) and weekly usage limits with reset countdowns, using your Claude Code login.",
  "UUID": "com.hymnk.claudelimits",
  "Icon": "imgs/plugin/icon",
  "CategoryIcon": "imgs/plugin/category",
  "Category": "Claude Limits",
  "CodePath": "bin/plugin.js",
  "Version": "1.0.0.0",
  "SDKVersion": 2,
  "Nodejs": {
    "Version": "20"
  },
  "Software": {
    "MinimumVersion": "6.6"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "com.hymnk.claudelimits.limits",
      "Name": "Claude Usage",
      "Tooltip": "Claude session/weekly usage and time until reset. Press to refresh.",
      "Icon": "imgs/actions/limits/icon",
      "PropertyInspectorPath": "ui/limits-pi.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/limits/key",
          "ShowTitle": false
        }
      ]
    }
  ]
}
