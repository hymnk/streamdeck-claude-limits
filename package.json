{
  "name": "streamdeck-claude-limits",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/plugin.ts --bundle --platform=node --target=node20 --format=cjs --outfile=com.hymnk.claudelimits.sdPlugin/bin/plugin.js",
    "watch": "npm run build -- --watch",
    "preview": "esbuild scripts/preview.ts --bundle --platform=node --format=cjs --outfile=dist/preview.cjs && node dist/preview.cjs",
    "icons": "node scripts/make-icons.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.2.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
